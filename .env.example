# Progetto Supabase (Settings → API). La chiave anon è pubblica per natura: le regole stanno nel database.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Indirizzo pubblico dell'app, usato nel QR del cartoncino ospite.
VITE_PUBLIC_URL=https://alpstay.github.io/ShuttleHartmann/
# Solo per il prototipo (npm run build:demo): metterli in .env.demo.local, che resta fuori dal repository.
# VITE_DEMO_PIN_RECEPTION=
# VITE_DEMO_PIN_AUTISTA=
